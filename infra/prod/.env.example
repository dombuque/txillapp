# Copiar para infra/prod/.env e preencher. NUNCA fazer commit do .env.
# Gerar segredos fortes:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ── Base de dados, cache e painéis ─────────────────────────────────────────────
POSTGRES_PASSWORD=
REDIS_PASSWORD=
GRAFANA_PASSWORD=
ELASTIC_PASSWORD=

# ── API ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=               # >= 32 caracteres, único deste ambiente
PORT=3000
WEB_ORIGIN=https://app.txillapp.com,https://admin.txillapp.com
# O Redis (tempo real entre réplicas e limites de pedidos) liga-se no docker-compose.yml (REDIS_URL + REDIS_PASSWORD):
# não é preciso REDIS_URL aqui. Escala (docs/escala.md), todos opcionais:
# API_REPLICAS=3                   # processos da API atrás do nginx
# API_PG_POOL_MAX=20               # ligações ao PostgreSQL por réplica (o worker: WORKER_PG_POOL_MAX=10)
# API_STATEMENT_TIMEOUT_MS=30000   # tempo máximo de uma consulta nas réplicas (o worker: WORKER_STATEMENT_TIMEOUT_MS=300000)
# VIDEO_CONCURRENCY=1              # vídeos a converter ao mesmo tempo no worker

# Login com Google (opcional): origens autorizadas = https://app.txillapp.com
# GOOGLE_CLIENT_ID=

# Notificações no telemóvel:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@txillapp.com

# App no iPhone (APNs, direto à Apple). Passo a passo: docs/lojas/apns.md. Sem isto, o iPhone não recebe notificações.
# APNS_KEY_P8 = o ficheiro AuthKey_XXXXXXXXXX.p8 numa linha:  base64 -w0 AuthKey_XXXXXXXXXX.p8
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.txillapp.app
# true = TestFlight e App Store (api.push.apple.com); false = builds de desenvolvimento (sandbox)
APNS_PRODUCTION=true

# ── Compras pela loja (App Store / Google Play): só a verificação paga e o Bombar. Passo a passo: docs/lojas/iap.md ──
# Interruptor geral. DESLIGADO por omissão (mesmo com as credenciais abaixo): o catálogo diz enabled=false, verify e
# restore dão 503 e os avisos das lojas só ficam registados. Ligar só quando a app estiver na conta de programador própria.
IAP_ENABLED=false
# Apple: chave .p8 «In-App Purchase» (App Store Connect > Users and Access > Integrations > In-App Purchase), em base64:
#   base64 -w0 SubscriptionKey_XXXXXXXXXX.p8
IAP_APPLE_ISSUER_ID=
IAP_APPLE_KEY_ID=
IAP_APPLE_KEY_P8=
IAP_APPLE_BUNDLE_ID=com.txillapp.app
# Production (App Store e TestFlight) ou Sandbox (só testes). Em Production aceita também compras de sandbox (App Review),
# marcadas como Sandbox e fora das receitas; para recusar: IAP_APPLE_ACCEPT_SANDBOX=false
IAP_APPLE_ENV=Production
IAP_APPLE_ACCEPT_SANDBOX=true
# Google: conta de serviço com acesso à Google Play Developer API (o ficheiro JSON em base64: base64 -w0 conta.json)
IAP_GOOGLE_SERVICE_ACCOUNT_JSON=
IAP_GOOGLE_PACKAGE=com.txillapp.app
# Segredo do push do Pub/Sub (>= 24 caracteres; openssl rand -hex 24). URL: https://txillapp.com/api/v1/iap/google/rtdn?token=ESTE_SEGREDO
IAP_GOOGLE_RTDN_TOKEN=
# Ids dos produtos (iguais nas duas lojas), o raio fixo de cada pacote do Bombar e os preços de referência (centavos)
IAP_PRODUCT_VERIFY_MONTHLY=txillapp.verificado.mensal
IAP_PRODUCT_VERIFY_YEARLY=txillapp.verificado.anual
IAP_PRODUCT_BOOST_1D=txillapp.bombar.1d
IAP_PRODUCT_BOOST_3D=txillapp.bombar.3d
IAP_PRODUCT_BOOST_7D=txillapp.bombar.7d
IAP_BOOST_RADIUS_KM=1d:3,3d:3,7d:3
IAP_PRICES=txillapp.verificado.mensal=29900,txillapp.verificado.anual=299000,txillapp.bombar.1d=15000,txillapp.bombar.3d=40000,txillapp.bombar.7d=80000
IAP_CURRENCY=MZN

# Métricas para o Prometheus (token qualquer, >= 16 caracteres; o mesmo vai para monitoring/metrics_token)
METRICS_TOKEN=

# Prova de humano (Cloudflare Turnstile): painel da Cloudflare → Turnstile → Add widget (domínios txillapp.com e
# app.txillapp.com, modo «Invisible»). Sem a secreta fica desligada. Antes de a ligar, a CSP do nginx tem de deixar
# https://challenges.cloudflare.com em script-src e frame-src (ver o relatório da equipa de compliance).
# TURNSTILE_SECRET=
# TURNSTILE_SITEKEY=
# TURNSTILE_NATIVE=optional

# Verificação automática de fotos e vídeos (recomendado em produção)
IMAGE_MODERATION=local

# ── Armazenamento de fotos, vídeos e gravações: Cloudflare R2 ──────────────────
# Dois buckets: um PÚBLICO (domínio media.txillapp.com) e um PRIVADO (conversas). Nunca misturar.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<ID_DA_CONTA>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=txillapp-media
S3_PRIVATE_BUCKET=txillapp-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://media.txillapp.com

# ── Pesquisa (por omissão PostgreSQL; Elasticsearch é opcional) ────────────────
SEARCH_BACKEND=postgres
# SEARCH_BACKEND=elasticsearch
# ELASTICSEARCH_URL=http://elastic:${ELASTIC_PASSWORD}@elasticsearch:9200

# ── Cópias de segurança ────────────────────────────────────────────────────────
# Para onde vão (outro fornecedor que não o do servidor, idealmente). Compatível com S3.
BACKUP_S3_ENDPOINT=
BACKUP_S3_PROVIDER=Other        # Cloudflare | Backblaze (B2) | Other
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_BUCKET=txillapp-backups
# Chave PÚBLICA age:  age-keygen  (a privada guarda-se fora do servidor!)
AGE_PUBLIC_KEY=
# Aviso se a cópia falhar (opcional): https://healthchecks.io
HEALTHCHECK_URL=

# ── E-mail (confirmar contas e recuperar senha). Sem SMTP_USER/SMTP_PASS fica tudo desligado. ──
# Zoho: smtp.zoho.com (ou .eu/.in conforme o teu centro de dados), porta 465, utilizador = a caixa, senha = "palavra-passe de aplicação".
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Txillapp <suporte@txillapp.com>
PUBLIC_URL=https://txillapp.com

# SuperTxill (a IA do chat). Sem a chave, o SuperTxill responde que ainda está a acordar.
# ANTHROPIC_API_KEY=sk-ant-...
# SUPERTXILL_MODEL=claude-opus-5-5          # mais barato: claude-haiku-5-5
# SUPERTXILL_DAILY_LIMIT=20                 # respostas por pessoa e por dia
# SUPERTXILL_MONTHLY_CAP=3000               # respostas por mês, em toda a app (teto do custo)

# GIFs do GIPHY (chat, TxillGroups e comentários), sempre pelo nosso servidor: a chave fica aqui e o GIPHY não vê quem pesquisa.
# Sem a chave, os GIFs ficam escondidos na app. Chave do tipo "API" em https://developers.giphy.com/dashboard/ (ver docs/DEPLOY.md, 6.2).
# GIPHY_API_KEY=
# GIPHY_CHANNEL=txillapp                    # opcional: o canal do Txillapp no GIPHY (separador "Txillapp")

# Catálogo de música (docs/musica.md). Sem estas, o catálogo usa só o ccMixter e o Internet Archive (netlabels).
# As APIs da Jamendo e do Freesound só são grátis para uso não comercial: ligar só depois do acordo comercial com cada uma.
# JAMENDO_CLIENT_ID=                        # https://devportal.jamendo.com
# FREESOUND_TOKEN=                          # só para a secção «Sons»; https://freesound.org/apiv2/apply

# Chamadas de voz e vídeo: servidor TURN próprio (serviço coturn, perfil "calls"). Sem estas duas, as chamadas usam só STUN
# (funcionam na maioria das redes, falham em algumas redes móveis e de empresa) e "Esconder o meu IP" não está disponível.
# Gerar o segredo no servidor: openssl rand -hex 32
# TURN_URLS=turn:turn.txillapp.com:3478?transport=udp,turn:turn.txillapp.com:3478?transport=tcp
# TURN_SECRET=

# ── Música licenciada (comercial). Passo a passo e fornecedores: docs/musica-licenciada.md ──
# DESLIGADA por omissão: o status diz enabled=false e as rotas dão 404. Ligar só com contrato assinado e adaptador real.
MUSIC_LICENSED_ENABLED=false
# MUSIC_LICENSED_DRIVER=none
# MUSIC_LICENSED_API_URL=
# MUSIC_LICENSED_API_KEY=
# MUSIC_LICENSED_TERRITORIES=MZ
# MUSIC_LICENSED_CLIP_SECONDS=60
