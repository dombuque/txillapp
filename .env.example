# Copiar para apps/api/.env (nunca fazer commit de .env)
DATABASE_URL=postgres://txill:txill_dev@localhost:5433/txillapp
REDIS_URL=redis://localhost:6379
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-me-por-um-segredo-longo-e-aleatorio-com-pelo-menos-32-chars
PORT=3000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# Login com Google (opcional). Sem isto o botão "Continuar com Google" não aparece.
# Google Cloud Console → APIs e serviços → Credenciais → ID de cliente OAuth (Aplicação Web).
# Origens JavaScript autorizadas: http://localhost:5173 (e o domínio de produção).
# GOOGLE_CLIENT_ID=<o teu ID de cliente>.apps.googleusercontent.com

# Notificações no telemóvel (opcional). Sem isto ficam desligadas.
# Gerar um par de chaves: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:o-teu-email@exemplo.com

# Fotos e gravações (opcional). Por omissão ficam no disco do servidor (só para desenvolvimento).
# Para produção usa um bucket compatível com S3 (AWS S3, Cloudflare R2, MinIO…):
# STORAGE_DRIVER=s3
# S3_BUCKET=txillapp-media
# S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com   # vazio na AWS
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.o-teu-dominio.com           # leitura pública (CDN); sem isto usam-se URLs assinados

# Verificação automática de fotos (nudez / conteúdo sexual). Recomendado ligar em produção.
# 'local' corre um modelo no próprio servidor (as fotos não saem daqui). 'off' = desligado (desenvolvimento).
# IMAGE_MODERATION=local
# NSFW_MODEL=AdamCodd/vit-base-nsfw-detector
# MODEL_CACHE_DIR=./.models
# NSFW_REJECT_THRESHOLD=0.85
# NSFW_REVIEW_THRESHOLD=0.5

# Pesquisa com Elasticsearch (opcional). Por omissão usa-se o PostgreSQL.
#   docker compose -f infra/docker/docker-compose.yml --profile search up -d elasticsearch
#   npm run search:reindex -w @txillapp/api      # índice inicial
# SEARCH_BACKEND=elasticsearch
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_INDEX_PREFIX=txillapp

# Métricas para o Prometheus (opcional): /api/v1/metrics com este token.
# METRICS_TOKEN=
