# Copiar para apps/api/.env (nunca fazer commit de .env)
DATABASE_URL=postgres://txill:txill_dev@localhost:5433/txillapp
REDIS_URL=redis://localhost:6379
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-me-por-um-segredo-longo-e-aleatorio-com-pelo-menos-32-chars
PORT=3000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# Login com Google (opcional). Sem isto o botão "Continuar com Google" não aparece.
# Google Cloud Console → APIs e serviços → Credenciais → ID de cliente OAuth (Aplicação Web).
# Origens JavaScript autorizadas: http://localhost:5173 (e o domínio de produção).
# GOOGLE_CLIENT_ID=<o teu ID de cliente>.apps.googleusercontent.com
