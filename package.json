{
  "name": "txillapp",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "build": "npm run build -w @txillapp/shared && npm run build -w @txillapp/api && npm run build -w @txillapp/web",
    "dev:api": "npm run dev -w @txillapp/api",
    "dev:web": "npm run dev -w @txillapp/web",
    "migrate": "npm run migrate -w @txillapp/api",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build -w @txillapp/shared && npm run typecheck -w @txillapp/api && npm run typecheck -w @txillapp/web",
    "test": "npm run test -w @txillapp/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
