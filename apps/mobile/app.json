{
  "expo": {
    "name": "Txillapp",
    "slug": "txillapp",
    "version": "1.28.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "txillapp",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.txillapp.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O Txillapp usa a tua localização, com a app aberta e quando pedes, para sugerir sítios e locais perto de ti, mostrar o que há por perto e partilhares a tua localização numa conversa.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.txillapp.app",
      "versionCode": 62,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT",
        "ACCESS_NETWORK_STATE",
        "CHANGE_NETWORK_STATE",
        "WAKE_LOCK"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Txillapp",
      "shortName": "Txillapp",
      "backgroundColor": "#ffffff",
      "themeColor": "#ffffff"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "O Txillapp usa a câmara para tirares fotos e gravares vídeos para as publicações, mimos, tchekas, Zás e mensagens, para as videochamadas e para a selfie da verificação da conta.",
          "microphonePermission": "O Txillapp usa o microfone para gravares o som dos vídeos, as notas de voz e os teus clipes de música, e para falares nas chamadas.",
          "recordAudioAndroid": true
        }
      ],
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-audio",
      [
        "expo-media-library",
        {
          "photosPermission": "O Txillapp mostra as tuas fotos e vídeos para escolheres o que publicar ou enviar numa publicação, mimo, tcheka ou conversa.",
          "savePhotosPermission": "O Txillapp guarda fotos e vídeos na tua galeria quando pedes.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Txillapp usa a tua localização, com a app aberta e quando pedes, para sugerir sítios e locais perto de ti, mostrar o que há por perto e partilhares a tua localização numa conversa.",
          "locationAlwaysAndWhenInUsePermission": "O Txillapp só usa a tua localização com a app aberta: para sugerir sítios perto de ti e para partilhares a tua localização numa conversa.",
          "locationAlwaysPermission": "O Txillapp só usa a tua localização com a app aberta: para sugerir sítios perto de ti e para partilhares a tua localização numa conversa.",
          "locationFullAccuracyPermission": "O Txillapp precisa da localização exata para mostrar onde estás no mapa e enviar o ponto certo numa conversa.",
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#d6334f",
          "defaultChannel": "txillapp",
          "sounds": [
            "./assets/sounds/ring.wav"
          ]
        }
      ],
      "./plugins/withProguardRules"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
