{
  "expo": {
    "name": "Txillapp",
    "slug": "txillapp",
    "version": "1.4.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "txillapp",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.txillapp.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "O Txillapp usa a câmara para tirares fotos e gravares vídeos para publicar, stories e mensagens.",
        "NSMicrophoneUsageDescription": "O Txillapp usa o microfone para gravares vídeos e mensagens de voz.",
        "NSPhotoLibraryUsageDescription": "O Txillapp acede às tuas fotos para escolheres o que publicar ou enviar.",
        "NSPhotoLibraryAddUsageDescription": "O Txillapp guarda fotos e vídeos na tua galeria quando pedes.",
        "NSLocationWhenInUseUsageDescription": "O Txillapp usa a tua localização para sugerir sítios perto de ti e para partilhares a tua localização numa conversa.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.txillapp.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Txillapp",
      "shortName": "Txillapp",
      "backgroundColor": "#ffffff",
      "themeColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
